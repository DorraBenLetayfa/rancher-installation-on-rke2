#install haproxy on bastion

global
    log /dev/log local0
    log /dev/log local1 notice
    daemon

defaults
    log global
    timeout connect 30s
    timeout client 1800s
    timeout server 1800s


# ==========================================================
# RKE2 Kubernetes API
# VIP: 192.168.122.86
# Port: 6443
# TCP passthrough
# ==========================================================

frontend rke2-api
    bind 192.168.122.86:6443
    mode tcp
    option tcplog

    default_backend rke2-api-backend

backend rke2-api-backend
    mode tcp
    balance roundrobin
    option tcp-check

    server rke2-1-dbl 192.168.122.134:6443 check
    server rke2-2-dbl 192.168.122.170:6443 check
    server rke2-3-dbl 192.168.122.69:6443 check


# ==========================================================
# RKE2 Registration
# VIP: 192.168.122.86
# Port: 9345
# TCP passthrough
# ==========================================================

frontend rke2-registration
    bind 192.168.122.86:9345
    mode tcp
    option tcplog

    default_backend rke2-registration-backend

backend rke2-registration-backend
    mode tcp
    balance roundrobin
    option tcp-check

    server rke2-1-dbl 192.168.122.134:9345 check
    server rke2-2-dbl 192.168.122.170:9345 check
    server rke2-3-dbl 192.168.122.69:9345 check

# ==========================================================
# Rancher
# VIP: 192.168.122.25
# Port: 443
# ==========================================================

frontend rancher-https
    bind 192.168.122.25:443 ssl crt /etc/haproxy/certs/rancher.pem
    mode http
    option httplog

    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port 443
    http-request set-header X-Forwarded-For %[src]

    default_backend rancher-backend


backend rancher-backend
    mode http
    balance roundrobin

    option httpchk

    http-check connect
    http-check send meth GET uri /healthz ver HTTP/1.1 hdr Host bastion.example.com hdr X-Forwarded-Proto https hdr X-Forwarded-Port 443
    http-check expect status 200

    server rke2-1-dbl 192.168.122.134:80 check
    server rke2-2-dbl 192.168.122.170:80 check
    server rke2-3-dbl 192.168.122.69:80 check


